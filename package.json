{
  "name": "chinese-punctuation-to-english",
  "displayName": "Chinese Punctuation To English",
  "description": "中文标点符号转换为英文",
  "publisher": "buuug7",
  "icon": "media/icon.png",
  "author": "buuug7",
  "license": "MIT",
  "version": "1.2.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "中文",
    "标点符号",
    "中文标点符号",
    "标点符号转换",
    "中文标点符号转换为英文",
    "punctuation",
    "chinese",
    "chinese punctuation",
    "chinese punctuation to english"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Chinese Punctuation To English",
      "properties": {
        "chinese-punctuation-to-english.autoConvertOnSave": {
          "type": "boolean",
          "default": false,
          "description": "在保存文件时自动将中文标点符号转换为英文标点"
        }
      }
    },
    "commands": [
      {
        "command": "chinese-punctuation-to-english.toEnglish",
        "category": "Chinese-punctuation-to-english",
        "title": "To English Punctuation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "group": "Chinese-punctuation-to-english",
          "command": "chinese-punctuation-to-english.toEnglish"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.0.0",
    "glob": "^10.4.0",
    "mocha": "^11.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "homepage": "https://github.com/buuug7/chinese-punctuation-to-english-vsocode/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/buuug7/chinese-punctuation-to-english-vsocode.git"
  },
  "bugs": {
    "url": "https://github.com/buuug7/chinese-punctuation-to-english-vsocode/issues"
  }
}
